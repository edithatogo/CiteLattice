{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:citelattice:citation-request:1.0.0",
  "title": "CiteLattice citation count sidecar request",
  "type": "object",
  "properties": {
    "contract": {
      "const": "org.citelattice.citation_request"
    },
    "version": {
      "const": "1.0.0"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "population_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "citation_universe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "population_id",
        "citation_universe",
        "as_of"
      ],
      "additionalProperties": false
    },
    "missing": {
      "enum": [
        "reject",
        "bounds"
      ]
    },
    "export": {
      "enum": [
        "allowed",
        "denied",
        "unknown"
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "citations": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
                "description": "Canonical decimal u64, represented as a string to avoid binary64 rounding."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "citations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract",
    "version",
    "source",
    "context",
    "missing",
    "export",
    "observations"
  ],
  "additionalProperties": false,
  "$comment": "Rust additionally checks unique observation IDs, byte-length and whitespace/control-character invariants. Source digest is caller-declared, not independently verified against remote bytes."
}

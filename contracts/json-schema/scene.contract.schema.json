{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CiteLattice design contract",
  "description": "Design proposal only. Semantic invariants must also be verified in Rust and scientific tests.",
  "$id": "urn:citelattice:scene:0.1.0-design",
  "type": "object",
  "required": [
    "scene",
    "grammar",
    "tables",
    "marks",
    "timeline",
    "alignment",
    "level_of_detail",
    "accessible_data",
    "disclosure_policy"
  ],
  "properties": {
    "scene": {
      "$ref": "#/$defs/revision"
    },
    "grammar": {
      "type": "string",
      "minLength": 1
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "table",
          "row_keys",
          "membership",
          "transform",
          "value",
          "uncertainty"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "$ref": "#/$defs/revision"
          },
          "row_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "membership": {
            "oneOf": [
              {
                "$ref": "#/$defs/revision"
              },
              {
                "type": "null"
              }
            ]
          },
          "transform": {
            "$ref": "#/$defs/revision"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "uncertainty": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "statistical",
                "source_coverage",
                "entity_resolution",
                "model",
                "layout"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "alignment": {
      "oneOf": [
        {
          "$ref": "#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "level_of_detail": {
      "oneOf": [
        {
          "$ref": "#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "accessible_data": {
      "$ref": "#/$defs/revision"
    },
    "disclosure_policy": {
      "$ref": "#/$defs/revision"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "revision": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
